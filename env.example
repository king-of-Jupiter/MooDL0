# Backend runtime (Moodle-only, no local backend required)
APP_ENV=production

# Default extension API settings (used to prefill popup fields)
MOODLE_API_BASE_URL=https://syncshare.naloaty.me/api
MOODLE_API_TOKEN=
MOODLE_API_TIMEOUT_MS=4000

# Link to the Telegram channel shown in extension popup
TELEGRAM_CHANNEL_LINK=https://t.me/moodl0_news

# Public extension build defaults (GitHub Actions -> js/build_config.js)
REPOSITORY_URL=https://github.com/king-of-Jupiter/MooDL0
UPDATE_CHECK_URL=
BUILD_CHANNEL=local
BUILD_ID=local-dev
RELEASE_PUBLIC_KEY=

# Backend release/update controls
EXTENSION_PROJECT_VERSION=3.2.0
EXTENSION_LATEST_VERSION=3.2.0
EXTENSION_REQUIRED_VERSION=
EXTENSION_RELEASE_URL=
EXTENSION_REPOSITORY_URL=https://github.com/king-of-Jupiter/MooDL0
EXTENSION_KNOWN_BUILD_IDS=
V2_RATE_LIMIT_PER_MINUTE=120
